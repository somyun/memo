          "cookies": [],
          "content": {
            "size": 35778,
            "mimeType": "text/javascript",
            "compression": 0,
            "text": "  /**\n   *  [TPLService 사용자 정의 항목 고객사 프로젝트 환경에 맞게 변경]\n   *  변수이름의 경우 do_property, do_method 시 사용하기 때문에 변수이름 변경시 do_property, do_method 함수 내의 변수이름도 변경 필요\n   */\n   var openurl = \"https://127.0.0.1\";  //고정(변경불가) https 를 사용 할 경우 https://127.0.1 로 변경 \n   var setport = -1; //-p옵션을 통해 넣었던 포트번호가 있으면 그 번호를 넣어야 함; 없을 경우 -1\n   var openport = -1; //openport가 실패할 경우 시도할 처음 port 번호\n   var findport = false; //setport 혹은 쿠키값으로 먼제 port 찾을때 false;\n   var minport = 7895; //연결 가능한 port를 찾을때 시작 port  (http는 7895~7935, https는 7936~7966)\n   var maxport = 7935; // 연결 가능한 port를 찾을때 최대 범위\n\n  ///***************************************************************************************************************************** */\n  //WebSocket 사용\n  var objWebSocket;                                      //WebSocket Object\n  var bWebsocketUse = false;                              //WebSocket 사용 유무: true:사용, false:사용안함.\n  var szprotocol = window.location.protocol;             //WebSocket protocol 스트링.\n  \n  if(bWebsocketUse)\n  {\n    if(szprotocol == \"http:\")\n    {\n      szprotocol = \"ws:\";\n      //*  ws( http ) 사용시 사용되는 port\n\t    minport = 7970;                                 //연결 가능한 WebSocket port를 찾을때 시작 port  (ws(http)는 7970~7981, wss(https)는 7982~7992)\t  \n\t    maxport = 7981;                                 //연결 가능한 WebSocket port를 찾을때 시작 port  (ws(http)는 7970~7981, wss(https)는 7982~7992)\t \n    }\n    else if(szprotocol == \"https:\")\n    {\n      szprotocol = \"wss:\";\n      //*  wss( https ) 사용시 사용되는 port\n      minport = 7982;                                 //연결 가능한 WebSocket port를 찾을때 시작 port  (ws(http)는 7970~7981, wss(https)는 7982~7992)\t  \n      maxport = 7992;                                 //연결 가능한 WebSocket port를 찾을때 시작 port  (ws(http)는 7970~7981, wss(https)는 7982~7992)\t  \n    }\n  }else{\n    if(szprotocol == \"http:\")\n    {\n      //*  http 사용시 사용되는 port\n\t    minport = 7895;                \t\t\t\t\t\t\t\t\t\t//연결 가능한 port를 찾을때 시작 port  (http는 7895~7935, https는 7936~7966)\t\n\t    maxport = 7935;                \t\t\t\t\t\t\t\t\t\t//연결 가능한 port를 찾을때 최대 범위\n    }\n    else if(szprotocol == \"https:\")\n    {\n      //*  https 사용시 사용되는 port\n\t    minport = 7936;                \t\t\t\t\t\t\t\t\t\t//연결 가능한 port를 찾을때 시작 port  (http는 7895~7935, https는 7936~7966)\t \n\t    maxport = 7966;                \t\t\t\t\t\t\t\t\t\t//연결 가능한 port를 찾을때 최대 범위 \n    }\n  }\n  \n\topenurl = szprotocol + \"//127.0.0.1\";  \t\t\t\t//고정(변경불가) https 를 사용 할 경우 https://127.0.0.1 로 변경 \n\n  /***************************************************\n  //local File Test 용으로.. 로컬 서버 테스트 시 제거..\n  if(bWebsocketUse){\n    if( szprotocol == \"file:\" )\n    {\n      openurl = \"ws://127.0.0.1\";\n      minport = 7970; \n      maxport = 7981;        \n    }\n  }else{\n    if( szprotocol == \"file:\" )\n    {\n      openurl = \"http://127.0.0.1\";\n      minport = 7895; \n    }\n  }\n  ****************************************************/  \n  ///***************************************************************************************************************************** */\n   \n   // 아래부터는 사이트에 맞게 수정이 필요합니다.     \n   /**\n   var strServerPath = \"http://support.tobesoft.co.kr/Next_JSP/XFShowcase/UI\"\n   var strKey = \"XFShowCase\"; //엑스플랫폼 애플리케이션에서 사용하는 Key id\n   var strADL = strServerPath + \"/ShowCase.xadl\"; //엑스플랫폼 애플리케이션 ADL 경로를 지정하는 속성\n   */\n   \n\t var strServerPath = Server_Path;\n\t var strKey = \"eGovXplatform\";  //엑스플랫폼 애플리케이션에서 사용하는 Key id\t \n\t var strADL = strServerPath + \"XUI.xadl\";        //엑스플랫폼 애플리케이션 ADL 경로를 지정하는 속성\n   \n  \n   var strCachedir = \"%CACHE%\"; //캐쉬 위치\n   \n   //var strEnginesetupkey = \"{E05CD7D8-28AF-4577-89AC-E4F1F8ABF046}\"; // 9.2.2엔진 key\n   var strEnginesetupkey = \"{AA890DB4-7357-4237-82BB-D0B931AAB420}\"; // 9.2.1    //엔진키\n   //var strEnginesetupkey = \"{0239FCE5-88CF-48e9-912D-90DAFC25E38B}\"; // 9.2.0\n   //var strEnginesetupkey = \"{0D02E53C-704A-4B5D-88FD-353A5AA4202E}\"; // 9.1.0\n   //var strEnginesetupkey = \"{6C5A6355-54A4-49a3-9D53-B6EFBDE41B31}\"; // 분리엔진 사용할 경우 제공받은 엔진 키 사용 예)LIG 9.2.1   \n   \n   //var strVersion = \"9.1\";  //버전정보\n   //var strVersion = \"9.2\";  //버전정보\n   var strVersion = \"9.2.1\"; //버전정보\n   //var strVersion = \"9.2.2\"; //버전정보\n   \n   //var strComponentPath = \"%USERAPPLOCAL%TOBESOFT\\\\XPLATFORM\\\\\" + strVersion +\"\\\\\" + strKey + \"\\\\components\"; //컴포넌트 위치 엑스플랫폼 애플리케이션에서 사용하는 컴포넌트가 위치한 경로를 지정하는 속성입니다\n   var strComponentPath = \"%USERAPPLOCAL%\\\\XPLATFORM\\\\921\\\\component\\\\\";//\"%USERAPPLOCAL%\";   \n   \n   // var strGlobalvalue = \"GID:g=KJB\"; // newLauncher_XP.html 에서 셋팅 처리 \n   var strURL = location.search;\n   var tempvalue = strURL.substring(1).split(\"&\");\t  \n   var strGlobalvalue = tempvalue + \",gv_ssoUserId=\"+userId+\",gv_svcUrl=\"+Server_real_Path; //\"a:s=aa,gv_test:g=ABC,c=TEST\";    \n   \n   \n   var strLoadingimage = strServerPath + \"/install/img/loading_img.gif\";  // 로딩 이미지 화면이나 데이터 로딩 시 보이는 이미지를 지정하는 속성\n   var strSplashimage = strServerPath + \"/install/img/loading_img.gif\";   // 구동시 최초에 뜨는 이미지 안보이게 할 경우 http url 를 404 주소 호출\n   var strWallpapericon = strServerPath + \"/install/img/system_icon.ico\";       //아이콘 경로   \n   \n   var strWallpaperposition = \"desktop\"; // 아이콘 위치 지정 \"startmenu\"/ \"startup\" / \"programs\" / \"desktop\" 중 택일함 \n      \n   var strLocLuncherVer; //런처 local 버전\n   var strLauncherVersion = \"1,1,0,33\"; //런처 버전\n   var strDownloadPath = \"./install/download\"; // 런처 다운로드 서버 경로\n   \n   \n   var strLauncherFileName = \"TPLSvc_Setup.exe\";\n   var strXPlatformEngineFileName = \"XPLATFORM9.2.1_SetupEngine.exe\";\n   var bOnlyone = false; // XPlatform only 속성 설정\n\n\n   /**\n    *  TPL 프로그램 다운로드 시 function 정의\n    */\n    // TPLSvc.exe 다운 받기\n    function download_TPLSvc(type) {\n\n      if (type == \"newlanucher\") {\n        var downURL = strServerPath + strDownloadPath + \"/\" + strLauncherFileName;\n  \t  \tsetTimeout(function(){ window.opener = self;  self.close(); },1000);\n        return downURL;\n      } else {\n        var downURL = strServerPath + strDownloadPath + \"/\" + strXPlatformEngineFileName;\n        setTimeout(function(){ window.opener = self;  self.close(); },1000);\n        return downURL;\n      }\n    }\n    /**\n     * [TPL_Download description]\n     * TPLSvc 프로그램 다운로드 \n     */\n    \n    \n    function TPL_LauncherDownload(str) {\n      // var msg=\"Insall\";\n      // if(str==\"update\") { msg=\"Update\";}\n      var msg=\"설치 되지 않았습니다.\";\n      if(str==\"update\") { msg=\"업데이트 되었습니다.\";}\n      //var contents = \"Please \"+msg+\" TPLSvc Laucher \\n than Plese refresh browser or close browser and Run again\";\n      var contents = \"TPLSvc가 \" +msg+ \" TPLSvc를 다운로드 후 설치를 진행해 주시기 바랍니다.\";\n      \n      if(confirm(contents)==true){ \n    \t  //var divCon = document.getElementById(\"errorDiv\")\n          //divCon.innerHTML = \"<H3>\"+ contents +\"</H3>\";\n    \t  document.location = download_TPLSvc(\"newlanucher\");           \t\n      }else{\n    \t  setTimeout(fn_close(),1500);\n      }        \n    }\n    /**\n     * [XPLATFORM_EngineDownload description]\n     * XPLATFORM Engine 다운로드 \n     */\n    function XPLATFORM_EngineDownload() {\n\n      //var contents = \"Please Install XPlaform \\nthan close browser and run browser again\";\n      var contents = \"XPLATFORM Engine 이 설치 되지 않았습니다. XPLATFORM을 다운로드 후 설치를 진행해 주시기 바랍니다.\";\n      if(confirm(contents)==true){            \t \n    \t  //var divCon = document.getElementById(\"errorDiv\")\n          //divCon.innerHTML = \"<H3>\"+contents+\"</H3>\";\n          document.location = download_TPLSvc();   \t\n      }else{\n    \t  setTimeout(fn_close(),1500); \n      }\n    }\n\n    function istalledMsg(str) {\n      if(str==\"newlanucher\") {\n    \t  \n        var aDom = document.getElementById(\"linklaucher\");\n        aDom.className = \"disabled\";\n        aDom.innerHTML = \"설치완료 ?\";\n      } else {\n    \t  \n        var aDom = document.getElementById(\"linkXP\");\n        aDom.className = \"disabled\";\n        aDom.innerHTML = \"설치완료 ?\";\n      }\n    }\n    /**\n     * [fn_close description]\n     * WebBrowser(IE,Chorme) 종료 스크립트\n     * 크롬(Chorme) 브라우저의 경우 window.open 으로 뛰운 창이 아닐 경우 close 를 할 수 없음\n     */\n    function fn_close() {\n      \n      if(navigator.appVersion.indexOf(\"MSIE 7.\") >= 0 || navigator.appVersion.indexOf(\"MSIE 8.\") >= 0  ||\n         navigator.appVersion.indexOf(\"MSIE 9.\") >= 0 || navigator.appVersion.indexOf(\"MSIE 10.\") >=0  || \n         navigator.appVersion.indexOf(\"Trident\") >= 0  ) {\n\n        window.open('about:blank','_self').close();\n       } else {\n\n        window.opener = self;\n        self.close();\n       }     \n    }\n\n    function fn_closeMessage() { \n      var contents = \"<H1>잠시 후 화면은 자동 종료 됩니다</H1>\";\n      var divCon = document.getElementById(\"errorDiv\")\n      divCon.innerHTML = contents; \n      setTimeout(fn_close(),1500);\n      if(bWebsocketUse)\n      {\n        tpl_WebSockeClose();\n      }\n    }\n\n   /**\n    ***************** TPLService 사용자 정의 항목 끝  ******************************************************************\n    */\n\n  /**\n   * [TPLService 사용 예]\n   * TPL Service 의 경우 local 통신을 하게 되며 TPL Service 모듈의 설치 여부는 최초 통신의 성공 여부를 통해 통신이 실패 할 경우 모듈 설치를 진행\n   * TPL Service 는 Window OS(XP SP3 이상) 의 services 항목에 추가 되어 구동 되기 때문에 Window services 에 정상 등록 되지 않을 경우 사용이 불가능 할 수 있으며\n   * TPL Service 에서 사용하고 있는 port 를 혹시라도 PC 에서 사용을 막는 작업을 할 경우 사용 제한이 생길 수 있습니다.\n   */\n  \n  var objXP = {};\n  var xhrObject = null;\n  var xhrCreateObject = null;\n  var openurl_add = \"/launcher/xplatform\"; //고정(변경불가)\n  var debugmode = {debug:false,loglevel:\"debug\"}; // loglevel debug, info, error\n  var console = window.console || {log: function(){}}; // console 객체가 없는 IE 를 위한 처리 (IE8 이하)\n\n  /**\n   *  [trace description]\n   *  Debug mode 를 위한 trace function 정의\n   */\n  var trace = function() {\n      var msg = \"\";\n      if (debugmode.debug) {\n        var domText = document.getElementById('debugTextBox');        \n        if (domText) {\n          domText.style.display = \"block\";\n          msg += arguments[0];\n            for (var i = 1, len = arguments.length; i < len; i++) {\n                msg += \", \" + arguments[i];\n            }\n          domText.value += msg + \"\\n\";\n          console.log(msg);\n        }\n      }\n    };    \n\n   if (window.addEventListener) { //firefox, IE9, 파이어폭스, 오페라, 사파리, 크롬 전용\n       window.addEventListener(\"load\", function() {\n            //tpl_start();\n            if(bWebsocketUse)\n            {\n              tpl_WebSocketConnect();\n            }else{\n              tpl_start();\n            }\n       });\n       window.addEventListener(\"unload\", function() {\n            tpl_finish();\n       });\n       window.addEventListener(\"error\", function() {\n            http_onerror();\n       });\n   } else if (window.attachEvent) { //IE 전용\n       window.attachEvent(\"onload\", function() {\n            //tpl_start();\n            if(bWebsocketUse)\n            {\n              tpl_WebSocketConnect();\n            }else{\n             tpl_start();\n            }\n       });\n       window.attachEvent(\"onunload\", function() {\n            tpl_finish();\n       });\n       window.attachEvent(\"onerror\", function() {\n            http_onerror();\n       });\n   }\n\n    /**\n    *  [tpl_start description]\n    *  TPLService 와 통신을 하기 위한 준비 function \n    */\n    function tpl_start() {\n      //생성 및 id 할당\n      trace(\"tpl start\", \"생성 및 id 할당\");\n      objXP.platform = 'xplatform'; //필수 세팅\n      objXP.action = 'create'; //필수 세팅\n      //objXP.id = '';              // 통신이 성공하면 정보가 채워지므로 생략해도 무방\n\n      if (setport > 0) {\n         openport = setport;\n      } else {\n         openport = parseInt(getCookie(\"tplsvcopenport\"), 10) | 0;\n      }\n      if (openport > 0) {\n         findport = false;\n      } else {\n         findport = true;\n         openport = minport;\n      }\n      sendData(true, true, createProcess); // sendData(openpost, is_create, resultCallback)\n    }\n\n\n    function tpl_finish() {\n      //종료 ==> 종료는 생략할 수 있으나 런처 서비스에서 관련 정보를 일정 시간 동안 가지고 있지 않게 하려면 호출해야 함;\n      if(debugmode.loglevel==\"debug\") {\n        objXP.action = 'destroy';\n      }     \n      sendData(true, false, resultProcess);\n    }\n\n   function setCookie(name, value, expiredays) {\n       var todayDate = new Date();\n       todayDate.setDate(todayDate.getDate() + expiredays);\n       document.cookie = name + '=' + escape(value) + '; path=/; expires=' + todayDate.toGMTString() + ';';\n   }\n\n   function getCookie(name) {\n       var nameOfCookie = name + '=';\n       var x = 0;\n       while (x <= document.cookie.length) {\n           var y = (x + nameOfCookie.length);\n           if (document.cookie.substring(x, y) == nameOfCookie) {\n               if ((endOfCookie = document.cookie.indexOf(';', y)) == -1) {\n                   endOfCookie = document.cookie.length;\n               }\n               return unescape(document.cookie.substring(y, endOfCookie));\n           }\n           x = document.cookie.indexOf(' ', x) + 1;\n            if (x == 0) {\n              break;\n            }\n       }\n       return '';\n   }\n\n   function sendData(openpost, is_create, resultCallback) {\n    if(bWebsocketUse){\n      var jsonData;\n      jsonData = JSON.stringify(objXP);\n      if( objWebSocket != null) {\n        objWebSocket.send(jsonData);\n      }else{\n        trace(\"It can not create WebSocket or MozWebSocket\");\n        return null;\n      }\n     }else{\n        if (is_create && xhrCreateObject != null) {\n          delete xhrCreateObject;\n          xhrCreateObject = null;\n        } else if (is_create == false && xhrObject != null) {\n          delete xhrObject;\n          xhrObject = null;\n        }\n\n        //XMLHttpRequest, XDomainRequest(ie8,9) 객체로 서버와 연결하기 위해 사용한다\n        //W3C에서 낸 CORS 를 사용해서 CrossDomain 데이터처리 할때, XMLHttpRequest(이하 XHR)이없는 IE계열에서는 \n        //IE8+ 부터 XDomainRequest(이하 XDR)를 사용해서 CORS를 지원한다고 합니다.\n        //따라서, IE8,9 버전에서 돌아가도록 하기위해 XDomainRequest 프로토콜을 추가로 사용합니다.          \n        var xhrObj = null;\n\n          if (window.XDomainRequest) {\n              xhrObj = new XDomainRequest();\n              xhrObj.reqType = 2;\n          } else if (window.XMLHttpRequest) {\n              xhrObj = new XMLHttpRequest();\n              xhrObj.reqType = 1;\n          }\n\n\n        if (xhrObj == null) {\n          trace(\"It can not create XMLHttpRequest or XDomainRequestx\");\n          return null;\n        }\n\n        if (is_create) {\n          xhrCreateObject = xhrObj;\n        } else {\n          xhrObject = xhrObj;\n        }\n        if (xhrObj.reqType != 2) {\n          xhrObj.onreadystatechange = resultCallback;\n        } else {\n          xhrObj.onload = resultCallback;\n          xhrObj.onerror = http_onerror;\n          xhrObj.ontimeout = http_ontimeout;\n        }\n\n        var jsonData;\n        jsonData = JSON.stringify(objXP);\n\n        var timestamp = \"/\" + new Date().getTime(); //cache 방지용\n        var send_url = openurl + \":\" + openport + openurl_add + timestamp;\n\n          if (xhrObj.reqType != 2) {\n            if (openpost) {\n                xhrObj.open(\"POST\", send_url, \"true\");\n                xhrObj.send(jsonData);\n            } else {\n                xhrObj.open(\"GET\", send_url + \"?\" + jsonData, \"true\");\n                xhrObj.send();\n            }\n          } else {\n            if (openpost) {\n                xhrObj.open(\"POST\", send_url);\n                xhrObj.send(jsonData);\n            } else {\n                xhrObj.open(\"GET\", send_url);               \n                setTimeout(function () {xhrObj.send();}, 0);\n            }\n          }\n          //return xhrObj;\n      }\n    }\n\n    /**\n     * [createProcess description]\n     * TPLSvc 통신준비 callback function Error 가 발생 할 경우 http_onerror function 에서 설치 유무 확인\n     * 통신이 성공 할 경우 TPLSvc launcher version 확인 \n     */\n    function createProcess() {\n      if (xhrCreateObject.readyState == 4 || xhrCreateObject.reqType == 2) {\n        if ((xhrCreateObject.status == 200 || xhrCreateObject.reqType == 2) && launcher_response(xhrCreateObject.responseText)) {\n          setCookie(\"tplsvcopenport\", openport, 14);\n          if(debugmode.loglevel==\"debug\") {\n            trace(\"createProcess\", \"after setCookie\", \"action : \" + objXP.action);\n          }\n\n          objXP.action = 'check';\n          objXP.value = { \"getlauncherversion\": {} };\n          sendData(true, false, checkUpdateLauncher);\n\n        } else if (xhrCreateObject.status == 0) {\n\n          if(debugmode.loglevel==\"debug\") {\n            trace(\"createProcess function Error XMLHttpRequest status : \" + xhrCreateObject.status);\n          }\n          return http_onerror();\n\n        } else {\n          trace(\"http error : \" + xhrCreateObject.status);\n        }\n      }\n    }\n\n    function checkUpdateLauncher() {\n      if (xhrObject.readyState == 4 || xhrObject.reqType == 2) {\n        if (xhrObject.status == 200 || xhrObject.reqType == 2 && launcher_response(xhrObject.responseText)) {\n                   \n          var resultJson = JSON.parse(xhrObject.responseText);\n          strLocLuncherVer = resultJson.value[\"getlauncherversion\"].productversion;\n\n          if (strLauncherVersion > strLocLuncherVer) {\n            TPL_LauncherDownload(\"update\");\n          } else {\n\n            //istalledMsg(\"newlanucher\");\n            objXP.action = \"method\";            \n            objXP.value = { \"getengineversion\": { \"param\": [strEnginesetupkey], \"result\": null } };\n            sendData(true, false, checkXPlatformEngine); \n          }\n        }         \n      }      \n    }\n\n    function checkXPlatformEngine() {\n      if (xhrObject.readyState == 4 || xhrObject.reqType == 2) {\n        if (xhrObject.status == 200 || xhrObject.reqType == 2 && launcher_response(xhrObject.responseText)) {\n\n          var resultJson = JSON.parse(xhrObject.responseText);\n          var reg = new RegExp(strVersion, \"i\");\n          var rtnEngineVer = resultJson.value[\"getengineversion\"].result;\n          var strEgine = reg.test(rtnEngineVer);\n          \n          if (!strEgine) {\n            XPLATFORM_EngineDownload();\n          } else {\n\n            //istalledMsg();\n            do_property('setproperty', 'basic'); // XPlatform 구동을 위한 기본 속성 설정\n            //do_method('makeshortcut'); // 단축아이콘 생성\n            do_method('launch'); // XPlatform 실행\n          }\n\n        }\n      }\n    }\n\n    function resultProcess() {\n      if (xhrObject.readyState == 4 || xhrObject.reqType == 2) {\n        if (xhrObject.status == 200 || xhrObject.reqType == 2 && launcher_response(xhrObject.responseText)) {\n          if(debugmode.loglevel==\"debug\") {\n            trace(xhrObject.responseText);\n          }\n          var result = JSON.parse(xhrObject.responseText);\n          \n          if(result.value.launch = \"ok\") {\n            fn_closeMessage();\n            //setTimeout(fn_close, 1500);            \n          }\n        }\n      }\n    }\n\n    function http_ontimeout() {\n      if(debugmode.loglevel==\"debug\"||debugmode.loglevel==\"error\") {\n        trace(\"http_ontimeout\");\n      }\n      return http_onerror();\n    }\n\n    function http_onerror() {\n      if(debugmode.loglevel==\"debug\"||debugmode.loglevel==\"error\") {\n        trace(\"http_onerror \", \"first line\", \"action : \" + objXP.action, \"oepnport : \"+openport);\n      }\n\n      if (objXP.action == 'create') {\n        var isAttempt = localStorage.getItem(\"isAttempt\");\n        if(isAttempt==null || isAttempt==\"error\") {\n          //localStorage.setItem(\"isAttempt\", \"ok\"); // TPLSvc 파일 다운로드 flag 값 \n          TPL_LauncherDownload();\n        } else {        \n           if (findport == false) {\n               if (setport > 0) {\n                   setport = 0;\n                   openport = parseInt(getCookie(\"tplsvcopenport\"), 10) | 0;\n                   if (openport > 0) {\n                       sendData(true, true, createProcess);\n                       return;\n                   }\n               }\n               openport = minport;\n           } else {\n               openport++;\n\n           }\n           findport = true;\n\n           if (openport <= maxport) {\n               sendData(true, true, createProcess);\n           } else {\n              localStorage.setItem(\"isAttempt\", \"error\");\n              alert(\"프로그램 추가 제거 항목에서 TPLSvc 프로그램이 설치 되어있는지 확인 및 Window 서비스 항목에서 TPLSvc 서비스 중지 되어 있는지 확인 바랍니다.\");\n              if(debugmode.loglevel==\"debug\"||debugmode.loglevel==\"error\") {\n                trace(\"프로그램 추가 제거 항목에서 TPLSvc 프로그램이 설치 되어있지 확인 및 Window 서비스 항목에서 TPLSvc 서비스 중지 되어 있는지 확인 바랍니다.\");\n              }\n           }\n         }\n      }\n    }\n\n\n    function launcher_response(result) { \n      //var result = resultObject.responseText;\n      if (result.length <= 0) {\n         return false;\n      }\n      try {\n        var objResult = JSON.parse(result);\n          //var objResult = eval('(' + result + ')');\n          if (objResult.result == \"success\" && objResult.id.length > 0) {\n             objXP = objResult;\n             return true;\n          } else {\n            if(debugmode.loglevel==\"debug\"||debugmode.loglevel==\"error\")\n               trace(\"launcher_response error msg\", objResult.result);\n               return false;\n            }\n      } catch (e) {\n        if(debugmode.loglevel==\"debug\"||debugmode.loglevel==\"error\") {\n          trace(\"launcher_response : \" + e.message)\n          return false;\n        }\n      }\n    }\n\n   /**\n    * 속성 및 메소드를 가져오기 위해서느 json 형식으로 값을 전달 후 json 으로 값을 받을 수 있습니다.\n    * TPlSvc 의 proeryt 값을 가져오기 위한 셋팅 - json 형식으로 값을 전달 후 json 형식으로 값을 전달 받음\n    * @param  {[action string]}\n    * @param  {[action_sub string]}\n    * @return \n    */\n    function do_property(action, action_sub) {\n\n      if (action == 'setproperty') {\n         //property 설정 ==> action = 'property' value = {\"property명\" : \"property값\", ... };\n         objXP.action = 'setproperty';\n         if (action_sub == 'basic') {\n             objXP.value = {\n                 \"key\": strKey,\n                 \"xadl\": strADL,\n                 \"componentpath\": strComponentPath,\n                 \"cachedir\": strCachedir,\n                 \"splashimage\": strSplashimage,\n                 \"loadingimage\": strLoadingimage,\n                 \"commthreadwaittime\": 1,\n                 \"version\": strVersion,\n                 \"commthreadcount\": 3,\n                 \"errorfile\": \"xplatform.xml\",\n                 \"globalvalue\": strGlobalvalue,\n                 \"onlyone\": bOnlyone,\n                 \"showiniterror\": false,\n                 \"usewininet\": true,\n                 \"enginesetupkey\": strEnginesetupkey,\n                 \"splashmessage\": \"new lanucher test...\"\n             };\n         }\n      } else if (action == 'getproperty') {\n         //property 설정 ==> action = 'property' value = {\"property명\" : \"property값\", ... };\n         objXP.action = 'getproperty';\n         objXP.value = {\n             \"key\": \"\",\n             \"xadl\": \"\",\n             \"componentpath\": \"\",\n             \"cachedir\": \"\",\n             \"splashimage\": \"\",\n             \"loadingimage\": \"\",\n             \"commthreadwaittime\": 0,\n             \"version\": \"\",\n             \"commthreadcount\": 0,\n             \"errorfile\": \"\",\n             \"globalvalue\": \"\",\n             \"onlyone\": bOnlyone,\n             \"showiniterror\": false,\n             \"usewininet\": true,\n             \"enginesetupkey\": \"\",\n             \"splashmessage\": \"\"\n         };\n      } else {\n         return;\n      }\n\n      sendData(true, false, resultProcess);\n    }\n\n   /**\n    * @param  {[action string]}\n    * @return \n    */\n    function do_method(action) {\n      objXP.action = 'method';\n\n      if (action == 'makeshortcut') {\n         //method 실행 ==> action = 'method' value = {\"method명\" : {\"param\" : method 입력값 array }};\n         //do_property('setproperty', 'basic');\n         objXP.value = {\n             \"makeshortcut\": {\n                 \"param\": [strKey, strWallpapericon, strWallpaperposition, false]\n             }\n         };\n      } else if (action == 'launch') {\n         //method 실행 ==> action = 'method' value = {\"method명\" :  };\n         objXP.value = {\n             \"launch\": \"ok\"\n         };\n         check_event = true;\n      } else if (action == 'isexistshortcut') {\n         //method 실행 ==> action = 'method' value = {\"method명\" : {\"param\" : method 입력값 array, \"result\" : 결과값 }};\n         objXP.value = {\n             \"isexistshortcut\": {\n                 \"param\": [strKey, \"startmenu\", true],\n                 \"result\": null\n             }\n         };\n      } else if (action == 'download') {\n         //method 실행 ==> action = 'method' value = {\"method명\" : };\n         objXP.value = {\n             \"download\": null\n         };\n      } else if (action == 'addWebInfo') {\n         //method 실행 ==> action = 'method' value = {\"method명\" : {\"param\" : method 입력값 array }};\n         objXP.value = {\n             \"addWebInfo\": {\n                 \"param\": [window.document.cookie]\n             }\n         };\n      } else if (action == 'getengineversion') {\n         //method 실행 ==> action = 'method' value = {\"method명\" : {\"param\" : method 입력값 array, \"result\" : 결과값 }};\n         objXP.value = {\n             \"getengineversion\": {\n                 \"param\": [strEnginesetupkey],\n                 \"result\": null\n             }\n         };\n      } else if (action == 'deleteshortcut') {\n         //method 실행 ==> action = 'method' value = {\"method명\" : {\"param\" : method 입력값 array, \"result\" : 결과값 }};\n         objXP.value = {\n             \"deleteshortcut\": {\n                 \"param\": [strKey, \"startmenu\", true],\n                 \"result\": null\n             }\n         };\n      } else {\n         return;\n      }\n\n      sendData(true, false, resultProcess);\n    }\n\n\n\n    function get_event(action) {\n\n      objXP.action = 'event';\n      if (action == 'error') {\n         //get event info  ==> action = 'event' value = {\"event명\" : {...}};\n         if (add_value) {\n             objXP.value = '{ \"error\": { \"code\": 0, \"message\": \"\" } }';\n         } else {\n             objXP.value = {\n                 \"error\": {\n                     \"code\": 0,\n                     \"message\": \"\"\n                 }\n             };\n         }\n      } else {\n         return;\n      }\n\n      sendData(true, false, resultProcess);\n    }\n\n\n\n  //--------------------------------------------------------------------------------------------------------------\n\t// WebSocket 사용 하는 경우\n\t//--------------------------------------------------------------------------------------------------------------\n  function tpl_WebSocketConnect()\n  {\n    tpl_ConnectData();\n\n    var timestamp = \"/\" + new Date().getTime(); //cache 방지용\n    var path = openurl + \":\" + openport + openurl_add + timestamp;\n\n    if (\"WebSocket\" in window) {\n      objWebSocket = new WebSocket(path);\n    } else if (\"MozWebSocket\" in window) {\n      objWebSocket = new MozWebSocket(path);\n    }\n\n    if(debugmode.loglevel==\"debug\") {\n      trace(\"tpl Websocket tpl_WebSocketConnect Path\", path);\n    }\n    \n    objWebSocket.onopen = function(evt) { onOpen(evt) };\n    objWebSocket.onclose = function(evt) { onClose(evt) };\n    objWebSocket.onmessage = function(evt) { onMessage(evt) };\n    objWebSocket.onerror = function(evt) { onError(evt) };\n  }\n\n  function tpl_ConnectData()\n  {\n    //WebSocket Object 생성 전 미리 Port 설정.\n    //생성 및 id 할당\n    trace(\"tpl Websocket tpl_Connect\", \"생성 및 id 할당\");\n    objXP.platform = 'xplatform'; //필수 세팅\n    objXP.action = 'create';    //필수 세팅\n\n    if (setport > 0) {\n        openport = setport;\n        if(debugmode.loglevel==\"debug\") {\n\t\t\t\t\ttrace(\"tpl Websocket tpl_Connect Port 0\", openport);\n\t\t\t\t}\n    } else {\n        //사용 안함\n        //openport = parseInt(getCookie(\"tplsvcopenport\"), 10) | 0;\n        if(debugmode.loglevel==\"debug\") {\n\t\t\t\t\ttrace(\"tpl Websocket tpl_Connect Port 1\", openport);\n\t\t\t\t}\n    }\n\n    if (openport > 0) {\n        //사용 안함\n        //findport = false;\n        if(debugmode.loglevel==\"debug\") {\n\t\t\t\t\ttrace(\"tpl Websocket tpl_Connect Port 2\", openport);\n\t\t\t\t}\n    } else {\n        findport = true;\n        openport = minport;\n\n        if(debugmode.loglevel==\"debug\") {\n\t\t\t\t\ttrace(\"tpl Websocket tpl_Connect Port 3\", openport);\n\t\t\t\t}\n    }\n  }\n  function onOpen(evt)\n  {\n    trace(\"tpl WebSocket Connect\", \"Success\");\n    sendData(true);\n  }\n\n  function onClose(evt)\n  {\n    tpl_WebSockeClose();\n    trace(\"tpl WebSocket DisConnect\", \"Success\");\n  }\n\n  function onMessage(evt)\n  {\n    var data = evt.data;\n\n    if(launcher_response(data)) {\n      if(debugmode.loglevel==\"debug\") {\n        trace(\"tpl Websocket Return onMessage \",data);\n      }\n      var result = JSON.parse(data);\n      httpCallBackReturn(result);\n    } else {\n      http_onerror();\n    }\n  }\n\n  function onError(evt)\n  {\n    if(debugmode.loglevel==\"debug\"||debugmode.loglevel==\"error\") {\n      trace(\"tpl Websocket onerror \", \"first line\", \"action : \" + objXP.action, \"oepnport : \"+openport);\n    }\n    \n    if (objXP.action == 'create') {\n       // var isAttempt = localStorage.getItem(\"isAttempt\");        \n       // if(isAttempt==null || isAttempt==\"error\") {\n          //localStorage.setItem(\"isAttempt\", \"ok\"); // TPLSvc 파일 다운로드 flag 값 \n          TPL_LauncherDownload();\n      //  } else {        \n          /*\n          //사용 안함\n          if (findport == false) {\n              if (setport > 0) {\n                  setport = 0;\n                  openport = parseInt(getCookie(\"tplsvcopenport\"), 10) | 0;\n                  if (openport > 0) {\n                      //sendData(true);\n                      console.log(\">>>>>>>>>>>>>>>>>> tplsvcopenport \" );\n                      return;\n                  }\n              }\n              openport = minport;\n          } else {\n              openport++;\n          }\n          */\n          if (setport > 0) {\n            setport = 0;\n          }\n          openport++;\n\n          findport = true;\n\n          if (openport <= maxport) {\n              //sendData(true);\n              if(debugmode.loglevel==\"debug\"||debugmode.loglevel==\"error\") {\n                trace(\"tpl Websocket onerror \", \">>>>>>>>>>>>>>>>>> Next Port Connect\", \"action : \" + objXP.action, \"oepnport : \"+openport);\n              }\n              objWebSocket = null;\n              tpl_WebSocketConnect();\n          } else {\n              localStorage.setItem(\"isAttempt\", \"error\");\n              alert(\"프로그램 추가 제거 항목에서 TPLSvc 프로그램이 설치 되어있지 확인 및 Window 서비스 항목에서 TPLSvc 서비스 중지 되어 있는지 확인 바랍니다.\");\n              if(debugmode.loglevel==\"debug\"||debugmode.loglevel==\"error\") {\n                trace(\"프로그램 추가 제거 항목에서 TPLSvc 프로그램이 설치 되어있지 확인 및 Window 서비스 항목에서 TPLSvc 서비스 중지 되어 있는지 확인 바랍니다.\");\n              }\n          }\n   //     }\n      } \n  }\n\n  /*----------------------------------------------------------------------------------------\n  get socket status\n  -----------------------------------------------------------------------------------------*/\t\t\n  function _getStatus(){\n    var rtn;\n    if(!tobjWebSocket) return \"CLOSED\";\n    if(objWebSocket.readyState == 0) rtn = \"CONNECTING\";\n    else if(objWebSocket.readyState == 1) rtn = \"OPEN\";\n    else if(objWebSocket.readyState == 2) rtn = \"CLOSE\";\n    else if(objWebSocket.readyState == 3) rtn = \"CLOSED\";\n    return rtn;\n  };\t\n\n  function tpl_WebSockeClose()\n  {\n    if(objWebSocket) {\n      objWebSocket.close();\n      objWebSocket = null;\n    }\n  }\n\n  function httpCallBackReturn(result, gubun) {\n    if(result.action) {\n      var action = result.action;\n\t\t\tif(action == \"create\") {\n        if(result.result == \"success\") {\n          objXP.action = 'check';\n          objXP.value = { \"getlauncherversion\": {} };\n          sendData(true, false);\n        }\n      }\n      else if(action == \"check\")\n\t\t\t{\n        strLocLuncherVer = result.value[\"getlauncherversion\"].productversion;\n        \n        if (strLauncherVersion > strLocLuncherVer) {\n          TPL_LauncherDownload(\"update\");\n        } else {\n          //istalledMsg(\"newlanucher\");\n          objXP.action = \"method\";            \n          objXP.value = { \"getengineversion\": { \"param\": [strEnginesetupkey], \"result\": null } };\n          sendData(true, false); \n        }\n      }\n      else if(action == \"setproperty\") {\n        if(debugmode.loglevel==\"debug\") {\n          trace(\"httpCallBackReturn\", \"after setproperty\", \"action : \" + objXP.action);\n        }\n      }\n      else if(action == \"method\") {\n        if(debugmode.loglevel==\"debug\") {\n          trace(\"httpCallBackReturn\", \"after method\", \"action : \" + objXP.action);\n        }\n\n        if(result.value.getengineversion) {\n          var reg = new RegExp(strVersion, \"i\");\n          var rtnEngineVer = result.value.getengineversion.result;\n          var strEgine = reg.test(rtnEngineVer);\n\n          if (!strEgine || rtnEngineVer == \"\") {\n            XPLATFORM_EngineDownload();\n          } else {\n            //istalledMsg();\n            do_property('setproperty', 'basic'); // XPlatform 구동을 위한 기본 속성 설정\n            //do_method('makeshortcut'); // 단축아이콘 생성\n            do_method('launch'); // XPlatform 실행\n          }\t\n        }\telse if(result.value.launch == true || result.value.launch == \"ok\") {\n          fn_closeMessage();\n        }\n      }\n      else if(action == \"destroy\") {\n\t\t\t\tfn_closeMessage();\n\t\t\t}\n\n    }else{\n\t    return http_onerror();\n    }\n  }"
          },
