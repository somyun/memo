            "mimeType": "text/html",
            "compression": 0,
            "text": "\n<!DOCTYPE html>\n<html>\n<head>\n\n\n\n\n\n<!-- sso import test 2021.11.12 --> \n\n\n\n<!-- // --> \n\n\n <link type=\"text/css\" href=\"./css/install.css\" rel=\"stylesheet\" />\n<SCRIPT LANGUAGE=\"JavaScript\"> \n\n//ssl 적용시 https 로 수정\nvar Server_Path = \"https://mis.humetro.busan.kr:443/FS/xui/\";\nvar Server_real_Path = \"https://mis.humetro.busan.kr:443/FS/\";\n//ssl 적용시 https 로 수정\n\n/** sso  test 2021.11.12 sso 변수명 userId_new를 useId로 변경할것**/\nvar userId = '115073';\n\n\n\n/** end 2017-06-27 : SSO 사번노출 문제 해결 **/\n\n</SCRIPT>\n  <meta http-equiv=\"content-type\" content=\"text/html; charset=UTF-8\" />\n  <title>개별업무통합관리시스템</title> \n    \n   <script type=\"text/javascript\">  \n\t function deleteCookie(name) {   \n\t    console.log('del');\n\t    document.cookie = name + \"=; path=/; expires=Thu, 01 Jan 1970 00:00:01 GMT;\";\n\t }   \n\t window.onload = function(){\n\t       deleteCookie(\"tplsvcopenport\");     \n\t };\n  </script>  \n  \n <script type=\"text/javascript\" src=\"./newlauncher_new.js\"></script>\n</head>\n<body style=\"height: 600px\" >\n<div id=\"container\" class=\"container\" >\n<div id=\"contents\">\n     <P align=\"center\"> \n     프로그램 설치 확인 중입니다.\n   </P>\n</div>\n<div id=\"errorDiv\" class=\"errorDiv\">\n  \n</div>\n</div>\n<div id=\"debugDiv\">\n    <!-- result -->\n    <textarea id=\"debugTextBox\" rows=\"50\" cols=\"150\" style=\"display:none; margin-top:150px; height:300px;\"></textarea>\n</div>\n\n    <!-- result -->\n <!--  <textarea id=\"txtResult\" type = \"hidden\" style=\"display:none; position: absolute; width: 836px; height: 464px; top: 100px; left: 10px\" wrap=\"hard\" /> -->\n</body>\n</html>"
          },
          "redirectURL": "",
